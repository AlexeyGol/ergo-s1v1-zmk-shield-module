#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define FN   2
#define SYS  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
// |   `   |   1   |   2   |   4   |   5   |   6   |                                  |   6   |   7   |   8   |   9   |   0   |  BSPC |  
// |  TAB  |   Q   |   W   |   E   |   R   |   T   |                                  |   Y   |   U   |   I   |   O   |   P   |  SW07 |
// |  ESC  |   A   |   S   |   D   |   F   |   G   |                                  |   H   |   J   |   K   |   L   |   ;   |  '    |
// | LCTL  |   Z   |   X   |   C   |   V   |   B   |                                  |   N   |   M   |   ,   |   .   |   /   |  SW19 | 
//         | SW25  | LEFT  | RIGHT |                                                                  | SW27  |  SW26 | SW25  | 
//                                                 | WTERM |  PTSC |    | SW29 | SW28 |
//                                                         |  SW30 |    | SW30 |
//                                  | SW31 | SPACE | SW33  |  SW34 |    | SW34 | SW33 | SPACE | SW31 |

            bindings = <
&kp GRAVE    &kp N1     &kp N2    &kp N3    &kp N4     &kp N5                             &kp N6    &kp N7  &kp N8     &kp N9      &kp N0     &kp MINUS
&kp TAB      &kp Q      &kp W     &kp E     &kp R      &kp T                              &kp Y     &kp U   &kp I      &kp O       &kp P      &kp BACKSLASH
&kp ESCAPE   &kp A      &kp S     &kp D     &kp F      &kp G                              &kp H     &kp J   &kp K      &kp L       &kp SEMI   &kp SQT
&kp LCTRL    &kp Z      &kp X     &kp C     &kp V      &kp B                              &kp N     &kp M   &kp COMMA  &kp PERIOD  &kp SLASH  &kp RIGHT_SHIFT
             &bootloader &kp LEFT  &kp RIGHT                                                                 &kp A      &kp A       &kp A       
                                                       &kp H   &kp J      &kp N6   &kp N7
                                                               &kp K      &kp N8
                                  &kp O     &kp SPACE  &kp P   &kp L      &kp N9   &kp N0   &kp SPACE &kp BACKSPACE         
            >;
        };

        fn_layer {
            // ---------------------------------------------------------------------------------------------------------------------------------
            // |BT_CLR|  F1  |  F2  |  F3  |  F4  |  F5  |                                                   |      | NLCK |  =   |  /   |  *   |      |
            // |      |  F6  |  F7  |  F8  |  F9  |  F10 |                                                   |      |  7   |  8   |  9   |  -   |      |
            // |      |      |      |      |      |      |                                                   |      |  4   |  5   |  6   |  +   |      |
            // |      |      |      |      |      | PTSC |      |      |      |         |      |      |      |      |  1   |  2   |  3   | ENT  |      |
            //        |      | INS  |      |      |      |      |  FN  |      |         |      |      |      |      |      |      |  .   | ENT  |
            //                                                         |      |         |      |

            bindings = <
&trans        &kp F1   &kp F2   &kp F3   &kp F4           &kp F5                                                                         &trans     &trans        &trans   &trans      &trans        &trans
&trans        &kp F6   &kp F7   &kp F8   &kp F9           &kp F10                                                                        &kp CARET  &kp N7        &kp N8   &kp N9      &kp PLUS      &trans
&kp CAPSLOCK  &kp F11  &kp F12  &kp INS  &kp PRINTSCREEN  &trans                                                                         &kp EQUAL  &kp N4        &kp N5   &kp N6      &kp MINUS     &trans
&mo 2         &trans   &trans   &trans   &trans           &trans           &kp LEFT_ALT  &trans    &kp C_MENU  &kp BACKSPACE             &trans     &kp N1        &kp N2   &kp N3      &kp ASTERISK  &trans
              &trans   &trans   &trans   &trans                    &trans  &trans        &trans    &trans      &kp COLON      &kp MINUS             &kp NUMBER_0  &kp DOT  &kp RETURN  &kp SLASH
                                                                                         &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans  &trans          &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans          &trans  &trans  &trans    &trans  &trans  &trans          &trans  &trans  &trans  &trans
                                                                &trans    &trans
            >;
        };
    };
};