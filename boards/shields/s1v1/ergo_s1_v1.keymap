#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>
#include <dt-bindings/zmk/bt.h>

// Local files
#include "keymap_bluetooth.dtsi"


// use &mo 1 for nav layer
#define L_BASE 0 
#define L_NAV  1
#define L_NUM  2
#define L_SYS  3


/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
    // Home Row Mod - hold tap
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0  1  2  3  4  5   // top left
                12 13 14 15 16 17  // Q row left
                24 25 26 27 28 29  // home row left
                36 37 38 39 40 41  // Z row left
                48 49 50
                86 87
                103
                54 55 58 60 61 62 63
            >;
            hold-trigger-on-release;
        };
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                6  7  8  9  10 11     // right number row
                18 19 20 21 22 23     // right Q row
                30 31 32 33 34 35     // right home row
                42 43 44 45 46 47     // right Z row
                51 52 53              // right bottom partial
                56 57 59 64 65 66 67  // right thumbs
            >;
            hold-trigger-on-release;
        };

    // My Mod Tap - for different kp on tap and hold
        my_mt: my_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&kp>, <&kp>;
        };
    // My Layer Mod Tap - Hold for momentary layer switch, tap for regular key
        my_lt: my_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
        };

    // Windows desktop switcher
        // switch left
        win_desk_l: win_desk_l {
            compatible = "zmk,behavior-macro";
            label = "WS_PREV";
            #binding-cells = <0>;
            bindings = <
                &kp LC(LG(LEFT))
            >;
        };
        // switch right
        win_desk_r: win_desk_r {
            compatible = "zmk,behavior-macro";
            label = "WS_NEXT";
            #binding-cells = <0>;
            bindings = <
                &kp LC(LG(RIGHT))
            >;
        };


    };

    combos {
        compatible = "zmk,combos";

        // Combo for system layer - sticky, one-shot - press combo, next key is catched as system and go back to previous layer
        combo_system {
            timeout-ms = <50>;
            key-positions = <0 11>;   // top-outer corners, both halves
            require-prior-idle-ms = <150>;
            bindings = <&sl L_SYS>;
        };
    };


    keymap {
        compatible = "zmk,keymap";
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
// BSPC - BACKSPACE
// M RBC - Mouse Right Button Click
// CALC - Calculator
// PTSC

        base {
            display-name = "BASE";

// |   `   | 1     |   2   |   3     |   4    |   5       |                                      |   6       |   7     |   8   |   9   |   0   |  BSPC |  
// |  TAB  | Q     |   W   |   E     |   R    |   T       |                                      |   Y       |   U     |   I   |   O   |   P   |  PIPE |
// |  ESC  | A WIN | S ALT | D SHIFT | F CTRL |   G       |                                      |   H CTRL  | J SHIFT | K ALT | L WIN |   ;   |  '    |
// | SHIFT | Z     |   X   |   C     |   V    |   B       |                                      |   N       |   M     |   ,   |   .   |   /   | SHIFT | 
//         | WIN   | LEFT  | RIGHT   |                                                                                 | SW27  |  SW26 | M RBC | 
//                                                        | WTERM |  PTSC |    | CALC    | SW28   
//                                                                |  SW30 |    | PG UP    
//                                   | BSPC   | SPACE nav | SW33  |  SW34 |    | PG DOWN | ENTER | SPACE nav | DEL     |

            bindings = <      
 //|              |            |           |             |             |         |                |        |    |          |            |            |                 |            |          |
    &kp GRAVE      &kp N1       &kp N2       &kp N3       &kp N4        &kp N5                                              &kp N6       &kp N7       &kp N8            &kp N9       &kp N0     &kp MINUS
    &kp TAB        &kp Q        &kp W        &kp E        &kp R         &kp T                                               &kp Y        &kp U        &kp I             &kp O        &kp P      &kp BACKSLASH
    &kp ESCAPE     &hml LGUI A  &hml LALT S  &hml LSHIFT D  &hml LCTRL F   &kp G                                               &hmr RCTRL H  &hmr RSHFT J  &hmr RALT K       &hmr RGUI L  &kp SEMI   &kp SQT
    &kp LEFT_SHIFT &kp Z        &kp X        &kp C        &kp V         &kp B                                               &kp N        &kp M        &kp COMMA         &kp PERIOD   &kp SLASH  &kp RIGHT_SHIFT
                   &kp LGUI     &kp LEFT     &kp RIGHT                                                                                   &kp HOME     &kp END           &mkp RCLK      
                                                                                           &kp H  &kp PSCRN     &kp N6      &kp N7 
                                                                                                  &kp K         &kp PAGE_UP 
                                                          &kp BACKSPACE &my_lt L_NAV SPACE &kp P  &kp K_CALC    &kp PAGE_DOWN &kp RETURN  &my_lt L_NAV SPACE  &my_lt L_NUM DEL 
            >;
        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        navigation_layer {
            display-name = "L_NAV";
            bindings = <
 //|       |          |        |        |           |       |       |      | |       |       |                  |                 |         |         |         |       |
    &trans  &trans     &trans   &trans   &trans      &trans                                   &trans             &trans            &trans   &trans    &trans    &trans
    &trans  &kp PG_UP  &kp HOME &kp UP   &kp END     &trans                                   &kp DEL            &kp HOME          &kp UP   &kp END   &kp PG_UP &trans
    &trans  &kp PG_DN  &kp LEFT &kp DOWN &kp RIGHT   &trans                                   &kp BACKSPACE      &kp LEFT          &kp DOWN &kp RIGHT &kp PG_DN &trans
    &trans  &trans     &trans   &trans   &win_desk_l &win_desk_r                              &win_desk_l        &win_desk_r       &trans   &trans  &trans  &trans
            &sl L_SYS  &trans   &trans                                                                                             &trans   &trans  &trans
                                                                  &trans  &trans              &kp C_VOLUME_DOWN  &kp C_VOLUME_UP
                                                                          &trans              &kp C_MUTE                  
                                         &trans      &trans       &trans  &trans              &trans             &trans            &trans   &trans
            >;

        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        numbers_layer {
            display-name = "L_NUM";
            bindings = <
 //|       |       |       |       |       |       |       |      | |       |       |         |       |          |             |       |       |
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans    &trans  &kp SLASH  &kp ASTERISK  &kp MINUS   &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans    &kp N7  &kp N8     &kp N9        &trans      &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &kp EQUAL &kp N4  &kp N5     &kp N6        &kp PLUS    &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans    &kp N1  &kp N2     &kp N3        &kp RETURN  &kp SLASH
            &trans  &trans  &trans                                                                     &kp N0     &kp DOT       &kp RETURN
                                                    &trans  &trans                   &trans    &trans
                                                            &trans                   &trans  
                                    &trans  &trans  &trans  &trans                   &trans    &trans  &trans     &trans
            >;

        };



// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        system_layer {
            // Called by top-outer corners, both halves

            // Bluetooth - Tap   = force OUT_BLE + select profile N; Hold ≥3s = disconnect profile N
            display-name = "L_SYS";
            bindings = <
 //|       |            |           |           |           |          |                 |      |    |    |               |       |       |       |       |       |       |
    &trans  &bt_ht 0 0   &bt_ht 1 1  &bt_ht 2 2  &bt_ht 3 3  &bt_ht 4 4                                                 &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans       &trans      &trans      &trans      &trans                                                     &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans       &trans      &trans      &trans      &trans                                                     &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans       &trans      &trans      &trans      &trans                                                     &trans  &trans  &trans  &trans  &trans  &trans
            &sys_reset   &trans      &trans                                                                                     &trans  &trans  &sys_reset
                                                                        &bt BT_CLR   &bootloader           &bootloader  &trans
                                                                                     &out OUT_USB          &trans
                                                 &trans      &trans     &trans       &trans                &trans  &trans  &trans  &trans                                                                
            >;
        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄
        template {
            display-name = "template";
            bindings = <
 //|       |       |       |       |       |       |       |      | |       |       |       |       |       |       |       |       |
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans                                                                   &trans  &trans  &trans
                                                    &trans  &trans                   &trans  &trans
                                                            &trans                   &trans
                                    &trans  &trans  &trans  &trans                   &trans  &trans  &trans  &trans                                                                
            >;
        };
    };
};