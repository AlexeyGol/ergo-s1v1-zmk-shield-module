#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/mouse.h>


// use &mo 1 for nav layer
#define BASE 0 
#define NAV  1
#define NUM  2
#define SYS  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    behaviors {
    // Home Row Mod - hold tap
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                0  1  2  3  4  5   // top left
                16 17 18 19 20 21  // Q row left
                32 33 34 35 36 37  // home row left
                48 49 50 51 52 53  // Z row left
                65 66 67
                86 87
                103
                116 117 118 119
            >;
            hold-trigger-on-release;
        };
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <
                10 11 12 13 14 15  // top right
                26 27 28 29 30 31  // Y row right
                42 43 44 45 46 47  // home row right
                56 57 58 59 60 61  // Z row right
                76 77 78
                88 89
                104
                120 121 122 123
            >;
            hold-trigger-on-release;
        };

    // My Mod Tap - for different kp on tap and hold
        my_mt: my_mt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&kp>, <&kp>;
        };
   // My Layer Mod Tap - Hold for momentary layer switch, tap for regular key
        my_lt: my_lt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            bindings = <&mo>, <&kp>;
        };

    // Windows desktop switcher
        win_desk_l: win_desk_l {
            compatible = "zmk,behavior-macro";
            label = "WS_PREV";
            #binding-cells = <0>;
            bindings = <
                &kp LC(LG(LEFT))
            >;
        };

        win_desk_r: win_desk_r {
            compatible = "zmk,behavior-macro";
            label = "WS_NEXT";
            #binding-cells = <0>;
            bindings = <
                &kp LC(LG(RIGHT))
            >;
        };
    }


    keymap {
        compatible = "zmk,keymap";
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄\
// BSPC - BACKSPACE
// M RBC - Mouse Right Button Click
// CALC - Calculator
// PTSC

        base {
            display-name = "BASE";

// |   `   | 1     |   2   |   3     |   4    |   5       |                                      |   6       |   7     |   8   |   9   |   0   |  BSPC |  
// |  TAB  | Q     |   W   |   E     |   R    |   T       |                                      |   Y       |   U     |   I   |   O   |   P   |  PIPE |
// |  ESC  | A WIN | S ALT | D SHIFT | F CTRL |   G       |                                      |   H CTRL  | J SHIFT | K ALT | L WIN |   ;   |  '    |
// | SHIFT | Z     |   X   |   C     |   V    |   B       |                                      |   N       |   M     |   ,   |   .   |   /   | SHIFT | 
//         | WIN   | LEFT  | RIGHT   |                                                                                 | SW27  |  SW26 | M RBC | 
//                                                        | WTERM |  PTSC |    | CALC    | SW28   
//                                                                |  SW30 |    | PG UP    
//                                   | BSPC   | SPACE nav | SW33  |  SW34 |    | PG DOWN | ENTER | SPACE nav | DEL     |

            bindings = <      
 //|              |            |           |             |             |         |                |        |    |          |            |            |                 |            |          |
    &kp GRAVE      &kp N1       &kp N2       &kp N3       &kp N4        &kp N5                                              &kp N6       &kp N7       &kp N8            &kp N9       &kp N0     &kp MINUS
    &kp TAB        &kp Q        &kp W        &kp E        &kp R         &kp T                                               &kp Y        &kp U        &kp I             &kp O        &kp P      &kp BACKSLASH
    &kp ESCAPE     &hml lgui A  &hml lalt S  &hml lsft D  &hml lctl F   &kp G                                               &hmr rctl H  &hmr rsft J  &hmr ralt K       &hmr rgui L  &kp SEMI   &kp SQT
    &kp LEFT_SHIFT &kp Z        &kp X        &kp C        &kp V         &kp B                                               &kp N        &kp M        &kp COMMA         &kp PERIOD   &kp SLASH  &kp RIGHT_SHIFT
                   &kp LGUI     &kp LEFT     &kp RIGHT                                                                                   &kp A        &kp A             &mkp RCLK      
                                                                                 &kp H            &kp PSCRN     &kp N6      &kp N7 
                                                                                                  &kp K         &kp PAGE_UP 
                                                          &kp BACKSPACE &my_lt NAV SPACE &kp P    &kp L         &kp PAGE_DOWN &kp RETURN  &my_lt 1 SPACE  &my_lt 2 DEL 
            >;
        };

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄\
        navigation_layer {
            display-name = "NAV";
            bindings = <
 //|       |          |        |        |           |       |       |      | |       |       |             |           |         |         |         |       |
    &trans  &trans     &trans   &trans   &trans      &trans                                   &trans        &trans      &trans   &trans    &trans    &trans
    &trans  &kp PG_UP  &kp HOME &kp UP   &kp END     &trans                                   &kp DEL        &kp HOME    &kp UP   &kp END   &kp PG_UP &trans
    &trans  &kp PG_DN  &kp LEFT &kp DOWN &kp RIGHT   &trans                                   &kp BACKSPACE &kp LEFT    &kp DOWN &kp RIGHT &kp PG_DN &trans
    &trans  &trans     &trans   &trans   &win_desk_l &win_desk_r                              &win_desk_l   &win_desk_r &trans   &trans  &trans  &trans
            &trans     &trans   &trans                                                                                  &trans   &trans  &trans
                                                                  &trans  &trans              &trans        &trans     
                                                                          &trans              &trans         
                                         &trans      &trans       &trans  &trans              &trans        &trans      &trans   &trans                                                                
            >; 

        }

// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄\
        numbers_layer {
            display-name = "NUM";
            bindings = <
 //|       |       |       |       |       |       |       |      | |       |       |         |       |          |             |       |       |
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans    &trans  &kp SLASH  &kp ASTERISK  &kp MINUS   &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans    &kp N7  &kp N8     &kp N9        &trans      &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &kp EQUAL &kp N4  &kp N5     &kp N6        &kp PLUS    &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans    &kp N1  &kp N2     &kp N3        &kp RETURN  &kp SLASH
            &trans  &trans  &trans                                                                     &kp N0     &kp DOT       &kp RETURN
                                                    &trans  &trans                   &trans    &trans
                                                            &trans                   &trans  
                                    &trans  &trans  &trans  &trans                   &trans    &trans  &trans     &trans                                                                
            >;

        }


        template {
            display-name = "template"
            bindings = <
 //|       |       |       |       |       |       |       |      | |       |       |       |       |       |       |       |       |
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
            &trans  &trans  &trans                                                                   &trans  &trans  &trans
                                                    &trans  &trans                   &trans  &trans
                                                            &trans                   &trans
                                    &trans  &trans  &trans  &trans                   &trans  &trans  &trans  &trans                                                                
            >;
        };
    };
};