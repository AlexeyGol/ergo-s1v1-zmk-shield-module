combos {
    compatible = "zmk,combos";

    // Combo for system layer - sticky, one-shot - press combo, next key is catched as system and go back to previous layer
    combo_system {
        timeout-ms = <50>;
        key-positions = <0 11>;   // top-outer corners, both halves
        require-prior-idle-ms = <150>;
        bindings = <&sl 3>; // L_SYS layer
    };

    // caps locked word for constants
    combo_caps_word {
        key-positions = <36 47>; // left and right shifts
        bindings = <&caps_word>;
    };

    // e r to delete previous word
    combo_delete_word {
        key-positions = <15 16>;
        bindings = <&kp LC(BSPC)>;
    };

    // u i for backspace
    combo_delete_word {
        key-positions = <19 20>;
        bindings = <&kp BSPC>;
    };
};
