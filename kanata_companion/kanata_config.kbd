(defcfg
  process-unmapped-keys yes
  ;; Device path for Ubuntu (verified from your system)
  linux-dev /dev/input/event4 ;; comment out for wins
  concurrent-tap-hold yes
)

(defsrc
  q w e r t y u i o p
  caps a s d f g h j k l ;
  z x c v b n m , . /
  spc
)

(defvar
  tap-time 150
  hold-time 170
  left-hand-keys  (q w e r t a s d f g z x c v b)
  right-hand-keys (y u i o p h j k l ; n m , . /)
)

(defalias
  ;; Caps Lock: Tap for Esc, Hold for Alt+Shift
  lang (tap-hold $tap-time $hold-time esc (multi lalt lshift))

  ;; Home Row Mods (Left) — hold only fires when a right-hand key is pressed
  a (multi f24 (tap-hold-release-keys $tap-time $hold-time a lmet $right-hand-keys))
  s (multi f24 (tap-hold-release-keys $tap-time $hold-time s lalt $right-hand-keys))
  d (multi f24 (tap-hold-release-keys $tap-time $hold-time d lsft $right-hand-keys))
  f (multi f24 (tap-hold-release-keys $tap-time $hold-time f lctl $right-hand-keys))

  ;; Home Row Mods (Right) — hold only fires when a left-hand key is pressed
  j (multi f24 (tap-hold-release-keys $tap-time $hold-time j rctl $left-hand-keys))
  k (multi f24 (tap-hold-release-keys $tap-time $hold-time k rsft $left-hand-keys))
  l (multi f24 (tap-hold-release-keys $tap-time $hold-time l ralt $left-hand-keys))
  ; (multi f24 (tap-hold-release-keys $tap-time $hold-time ;  rmet $left-hand-keys))

  ;; Space -> Navigation layer on hold
  spc (tap-hold $tap-time $hold-time spc (layer-while-held nav))

  ;; Navigation Macros
  ws-prev (multi lmet lctl left)
  ws-next (multi lmet lctl rght)
  win-tab (multi lmet tab)
  alt-tab (multi lalt tab)

  ;; Language switch macro: Explicitly hold Alt and tap Space
  lang-switch (macro (down lalt) 50 spc 50 (up lalt))
)

;; Reduced chord timeout to 45ms to avoid ghost combos while typing fast
(defchordsv2
  (e r) bspc 45 all-released ()
  (u i) del 45 all-released ()
  (m ,) @lang-switch 45 all-released ()
  (d k) (caps-word 2000) 45 all-released ()
)

(deflayer base
  q w e r t y u i o p
  @lang @a @s @d @f g h @j @k @l @;
  z x c v b n m , . /
  @spc
)

(deflayer nav
  ;; Row 1: Left hand (Q-R) pgup/home/up/end | Right hand (Y-P) del/home/up/end/pgup
  pgup home up   end  t    del  home up   end  pgup

  ;; Row 2: Left hand (A-F) pgdn/left/down/rght | Right hand (H-;) bspc/left/down/rght/pgdn
  _    pgdn left down rght g    bspc left down rght pgdn

  ;; Row 3: Bottom row macros (WinTab, Workspace Switch, AltTab)
  _    @win-tab @ws-prev @ws-next @alt-tab @alt-tab @ws-prev @ws-next @win-tab _

  ;; space
  _
)
